# =====================================================================
# Finanças da Família — variáveis de ambiente
# Copie para .env.local (local) ou cadastre na Vercel (produção).
# NUNCA commite valores reais. Segredos marcados (S) só no servidor.
# Para desenvolvimento local, `npm run setup:local` gera um .env.local pronto.
# =====================================================================

# ---------- App ----------
# URL pública do painel (usada em links de convite, OAuth e webhooks)
APP_URL=http://localhost:3000

# ---------- Banco de dados (S) ----------
# Produção: string de conexão do Supabase (Settings > Database > Connection pooling,
# modo "Transaction", porta 6543). Cada requisição roda como o papel `authenticated`
# com o JWT do usuário (RLS). Local: deixe vazio com LOCAL_DEV_AUTH=true.
DATABASE_URL=postgres://postgres.<project-ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# ---------- Supabase Auth ----------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# (S) Usada SOMENTE por jobs (upload de PDFs no Storage). Nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ---------- Modo local (NUNCA em produção; recusado na Vercel) ----------
LOCAL_DEV_AUTH=false
# (S) Assina o cookie de sessão local (>= 24 caracteres)
LOCAL_SESSION_SECRET=<gere-com-openssl-rand-base64-32>
# Postgres local (embedded-postgres)
LOCAL_PG_PORT=54329
LOCAL_PG_PASSWORD=fam-local-dev
LOCAL_PG_DATABASE=financeiro
# LOCAL_PG_DATA_DIR=.local/pgdata

# ---------- Segurança (S) ----------
# HMAC das chaves de limite de login (>= 24 caracteres)
LOGIN_RATE_LIMIT_SECRET=<gere-com-openssl-rand-base64-32>
# AES-256-GCM para tokens OAuth e segredos do WhatsApp: 32 bytes em base64
TOKEN_ENCRYPTION_KEY=<openssl-rand-base64-32>
# Vercel Cron envia "Authorization: Bearer $CRON_SECRET" (>= 24 caracteres)
CRON_SECRET=<gere-com-openssl-rand-base64-32>
# Assina o parâmetro state do OAuth do Google (>= 24 caracteres)
OAUTH_STATE_SECRET=<gere-com-openssl-rand-base64-32>

# ---------- Storage ----------
# local | supabase (padrão: local com LOCAL_DEV_AUTH, senão supabase; bucket fam_faturas)
STORAGE_DRIVER=supabase
LOCAL_STORAGE_DIR=.local/storage

# ---------- Gmail (por perfil) ----------
# live | mock | off  (padrão: live se GOOGLE_CLIENT_ID existir; mock no modo local)
GMAIL_MODE=live
GOOGLE_CLIENT_ID=<google-oauth-client-id>.apps.googleusercontent.com
# (S)
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>

# ---------- Open Finance (Pluggy) ----------
# live | sandbox | mock | off (padrão: live se PLUGGY_CLIENT_ID existir; mock no modo local)
PLUGGY_MODE=sandbox
PLUGGY_CLIENT_ID=<pluggy-client-id>
# (S)
PLUGGY_CLIENT_SECRET=<pluggy-client-secret>
# (S) Segredo do webhook: configure na Pluggy a URL <APP_URL>/api/pluggy/webhook?secret=<este valor>
PLUGGY_WEBHOOK_SECRET=<gere-com-openssl-rand-base64-32>
# Script do widget Pluggy Connect (confira a versão atual na documentação da Pluggy)
PLUGGY_CONNECT_SCRIPT_URL=https://cdn.pluggy.ai/pluggy-connect/v2.8.2/pluggy-connect.js

# ---------- WhatsApp (assistente da família) ----------
# evolution (padrão, "Central Whatsapp") | meta | simulator
WHATSAPP_PROVIDER=evolution
# URL que o provedor chama (padrão: <APP_URL>/api/whatsapp/webhook)
WHATSAPP_WEBHOOK_URL=https://<seu-deploy>.vercel.app/api/whatsapp/webhook
# (S) Enviado pela Evolution como "Authorization: Bearer <valor>" (>= 24 caracteres). Sem ele o webhook recusa tudo.
WHATSAPP_WEBHOOK_SECRET=<gere-com-openssl-rand-base64-32>

# Evolution API v2 (Baileys, self-hosted) — instância "financeiro" já criada pela Central
EVOLUTION_BASE_URL=https://centralw.ftcplay.com
EVOLUTION_INSTANCE_NAME=financeiro
# (S) Token DA INSTÂNCIA (header apikey). Nunca a chave global.
EVOLUTION_INSTANCE_TOKEN=
# (S) Alias aceito para o token acima
WHATSAPP_API_KEY=
# (S) Alternativa: arquivo com o token (lido só no servidor; permissão 600; nunca commitar)
# EVOLUTION_INSTANCE_TOKEN_FILE=/home/box/secrets/evolution/instances/financeiro.token
# Libera o botão de QR code (/instance/connect). Deixe false até a Central aplicar o proxy residencial.
EVOLUTION_ALLOW_CONNECT=false

# Meta WhatsApp Cloud API (alternativo)
META_WHATSAPP_PHONE_NUMBER_ID=<phone-number-id>
# (S)
META_WHATSAPP_ACCESS_TOKEN=<token-permanente-do-system-user>
# (S) Verifica X-Hub-Signature-256
META_WHATSAPP_APP_SECRET=<app-secret>
# (S) Usado na verificação GET do webhook (hub.verify_token)
META_WHATSAPP_VERIFY_TOKEN=<token-de-verificacao>
META_GRAPH_API_VERSION=v21.0

# ---------- Testes locais ----------
# TEST_PG_PORT=54330
